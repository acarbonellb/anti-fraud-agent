# Environment variable names for anti-fraud-agent.
# Values never go in the repo: copy to .env and fill in locally.
# Each variable lands here with a comment when the code that reads it does
# (see .claude/skills/env-var/SKILL.md).

# --- Developer tooling (read by Claude Code, not by the agent) ---
# Must be exported in your shell: Claude Code expands it in .mcp.json and
# does not read .env.
# GitHub PAT for the `github` MCP server. Shared with the satella-web
# workspace (same developer, same variable); it is a GitHub credential, not a
# Satella one. Needs Issues, Pull requests and Contents (read and write) on
# this repo. Without it the server fails to authenticate; skills fall back
# to `gh`.
SATELLA_GITHUB_MCP_PAT=

# --- Agent run limits (brief §4.2) ---
# Optional. Positive integers; empty means the default. Reaching one ends the
# run as `escalated` with the reason recorded.
# Max tool calls per run (default 30).
AGENT_MAX_TOOL_CALLS=
# Max LLM tokens (input + output) per run (default 200000).
AGENT_MAX_TOKENS=
# Max web searches per run (default 10).
AGENT_MAX_WEB_SEARCHES=

# --- Autonomy policy (brief §4.2) ---
# Optional. Minimum confidence (0..1) for an auto-resolved approval
# (default 0.85). Set it from the evals: the lowest value that keeps
# approved fraud at zero.
AGENT_AUTO_APPROVE_THRESHOLD=

# --- LLM provider (ADR 0008) ---
# Optional while running locally. Phase 1 uses a local open-source model
# behind an OpenAI-compatible server: LM Studio in server mode
# (Developer → Start Server) or Ollama.
# Name recorded with every run (default lmstudio).
AGENT_LLM_PROVIDER=
# Base URL up to /v1 (default http://localhost:1234/v1, LM Studio).
AGENT_LLM_BASE_URL=
# Model id as the server lists it at /v1/models (default qwen/qwen3.5-9b).
AGENT_LLM_MODEL=
# Secret. Not needed for local servers; for a paid provider, a demo-only key
# with a spend cap at the provider (brief §6.3).
AGENT_LLM_API_KEY=

# --- Web search (ADR 0015) ---
# Optional. Secret. Tavily key for `webSearch`: create one on tavily.com (free
# plan, 1,000 credits a month, no card: the spend cap). Without it the agent
# reviews without web search, and `pnpm eval` can't record.
TAVILY_API_KEY=
