# Environment variable names for anti-fraud-agent.
# Values never go in the repo: copy to .env and fill in locally.
# Each variable lands here with a comment when the code that reads it does
# (see .claude/skills/env-var/SKILL.md).

# --- Developer tooling (read by Claude Code, not by the agent) ---
# Must be exported in your shell: Claude Code expands it in .mcp.json and
# does not read .env.
# GitHub PAT for the `github` MCP server. Shared with the satella-web
# workspace (same developer, same variable); it is a GitHub credential, not a
# Satella one. Needs Issues, Pull requests and Contents (read and write) on
# this repo. Without it the server fails to authenticate; skills fall back
# to `gh`.
SATELLA_GITHUB_MCP_PAT=

# --- Agent run limits (brief §4.2) ---
# Optional. Positive integers; empty means the default. Reaching one ends the
# run as `escalated` with the reason recorded.
# Max tool calls per run (default 30).
AGENT_MAX_TOOL_CALLS=
# Max LLM tokens (input + output) per run (default 200000).
AGENT_MAX_TOKENS=
# Max web searches per run (default 4). A search past it is refused, not run:
# the model still decides, and an approval escalates.
AGENT_MAX_WEB_SEARCHES=

# --- Autonomy policy (brief §4.2) ---
# Optional. Minimum confidence (0..1) for an auto-resolved approval
# (default 0.85). Set it from the evals: the lowest value that keeps
# approved fraud at zero.
AGENT_AUTO_APPROVE_THRESHOLD=

# --- Spend control (brief §6.3.3, ADR 0017) ---
# Optional. The day's model budget (UTC day) in integer micro-dollars
# (default 2000000, $2). Every run first holds its worst case: AGENT_MAX_TOKENS
# at the model's dearest rate ($0.50 for Haiku 5.5 at 200000 tokens), so the
# budget also caps how many subjects one pass reviews. Reached, the scheduled
# pass stops and the rest of the feed waits for the next day.
AGENT_DAILY_BUDGET_MICROS=

# --- Agent store (ADR 0016) ---
# Optional. GCP project whose `(default)` Firestore database keeps runs, the
# feed cursor and the day's spend. Unset: the store is in memory and nothing
# survives the process. In Cloud Run the token comes from the metadata
# server; locally, use the emulator below (never your own Google login).
FIRESTORE_PROJECT_ID=
# Optional. `host:port` of the Firestore emulator
# (`gcloud emulators firestore start`); no token is sent to it.
FIRESTORE_EMULATOR_HOST=

# --- LLM provider (ADR 0008) ---
# Optional while running locally. Phase 1 uses a local open-source model
# behind an OpenAI-compatible server: LM Studio in server mode
# (Developer → Start Server) or Ollama. `anthropic` uses Claude through its
# SDK (#30); it bills per token, so the scripts run it only with --paid.
# Name recorded with every run (default lmstudio; or anthropic).
AGENT_LLM_PROVIDER=
# Base URL up to /v1 (default http://localhost:1234/v1, LM Studio). Ignored
# by anthropic.
AGENT_LLM_BASE_URL=
# Model id: as the server lists it at /v1/models (default qwen/qwen3.5-9b),
# or Claude's from the current models docs (claude-haiku-5-5).
AGENT_LLM_MODEL=
# Secret. Not needed for local servers; required by anthropic. For a paid
# provider, a demo-only key with a spend cap at the provider (brief §6.3):
# console.anthropic.com → API keys, in a workspace with a spend limit.
AGENT_LLM_API_KEY=
# Optional. anthropic only: low, medium, high, xhigh or max (default medium).
# How much Claude thinks before it answers; thinking is billed as output.
AGENT_LLM_EFFORT=

# --- Web search (ADR 0015) ---
# Optional. Secret. Tavily key for `webSearch`: create one on tavily.com (free
# plan, 1,000 credits a month, no card: the spend cap). Without it the agent
# reviews without web search, and `pnpm eval` can't record.
TAVILY_API_KEY=
