# context. Env files above all: values never go in an image.
.env*
.envrc
.git
.github
.husky
.claude
node_modules
coverage
dist
docs
evals
**/*.test.ts
# Test doubles (scripted model, fake Firestore and venues): nothing the job
# runs imports them, and ESLint keeps it that way.
src/test-support
